{
  "name": "nearguard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run model:check && next dev",
    "build": "npm run model:check && next build",
    "start": "npm run model:check && next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "model:check": "node scripts/check_model_artifacts.mjs",
    "model:train": "python scripts/train_model.py",
    "model:serve": "npm run model:check && python scripts/inference_service.py"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^14.2.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.20",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
